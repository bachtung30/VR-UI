--- !u!114 &4555221265558742137
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6094464372482020378}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- Kim lo\u1EA1i b\u1ECB g\u1EC9 do x\u1EA3y ra c\xE1c ph\u1EA3n \u1EE9ng
    oxi ho\xE1 \u2013 kh\u1EED\r\n- Ph\u1EA3n \u1EE9ng oxi ho\xE1 \u2013 kh\u1EED
    l\xE0 lo\u1EA1i ph\u1EA3n \u1EE9ng x\u1EA3y ra ph\u1ED5 bi\u1EBFn trong t\u1EF1
    nhi\xEAn, trong \u0111\u1EDDi s\u1ED1ng, s\u1EA3n xu\u1EA5t v\xE0 trong c\u01A1
    th\u1EC3 con ng\u01B0\u1EDDi.\r\n- Trong t\u1EF1 nhi\xEAn, ph\u1EA3n \u1EE9ng
    oxi ho\xE1 \u2013 kh\u1EED x\u1EA3y ra trong qu\xE1 tr\xECnh quang h\u1EE3p,
    ch\xE1y r\u1EEBng, n\xFAi l\u1EEDa phun tr\xE0o, l\xEAn men, ph\xE2n hu\u1EF7
    \u0111\u1ED9ng th\u1EF1c v\u1EADt,...\r\n- Trong \u0111\u1EDDi s\u1ED1ng v\xE0
    s\u1EA3n xu\u1EA5t, c\xE1c qu\xE1 tr\xECnh oxi ho\xE1 \u2013 kh\u1EED (nh\u01B0
    s\u1EF1 ch\xE1y c\u1EE7a nhi\xEAn li\u1EC7u, c\xE1c qu\xE1 tr\xECnh \u0111i\u1EC7n
    ph\xE2n, c\xE1c ph\u1EA3n \u1EE9ng x\u1EA3y ra trong pin, \u1EAFc quy,...) cung
    c\u1EA5p ph\u1EA7n l\u1EDBn n\u0103ng l\u01B0\u1EE3ng ph\u1EE5c v\u1EE5 cho c\xE1c
    ho\u1EA1t \u0111\u1ED9ng c\u1EE7a con ng\u01B0\u1EDDi. Nhi\u1EC1u qu\xE1 tr\xECnh
    oxi ho\xE1 \u2013 kh\u1EED l\xE0 c\u01A1 s\u1EDF c\u1EE7a c\xE1c qu\xE1 tr\xECnh
    s\u1EA3n xu\u1EA5t nh\u01B0 luy\u1EC7n kim, s\u1EA3n xu\u1EA5t ph\xE2n b\xF3n,
    d\u01B0\u1EE3c ph\u1EA9m, ph\u1EA9m nhu\u1ED9m, thu\u1ED1c b\u1EA3o v\u1EC7 th\u1EF1c
    v\u1EADt,...\r\n- Trong c\u01A1 th\u1EC3 ng\u01B0\u1EDDi, ph\u1EA3n \u1EE9ng
    oxi ho\xE1 \u2013 kh\u1EED x\u1EA3y ra trong qu\xE1 tr\xECnh ti\xEAu ho\xE1 th\u1EE9c
    \u0103n, oxi ho\xE1 d\u01B0\u1EE1ng ch\u1EA5t, l\xE3o ho\xE1 v\xE0 nhi\u1EC1u
    qu\xE1 tr\xECnh sinh ho\xE1.\r\n"
