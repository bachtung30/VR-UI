  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ph\u1EA3n \u1EE9ng oxi ho\xE1 \u2013 kh\u1EED r\u1EA5t ph\u1ED5 bi\u1EBFn
    v\xE0 hi\u1EC7n di\u1EC7n trong \u0111\u1EDDi s\u1ED1ng:\r\n\r\n- T\u1EF1 nhi\xEAn:
    Quang h\u1EE3p, l\xEAn men, ph\xE2n hu\u1EF7 h\u0169u c\u01A1, ch\xE1y r\u1EEBng,
    n\xFAi l\u1EEDa.\r\n- \u0110\u1EDDi s\u1ED1ng v\xE0 S\u1EA3n xu\u1EA5t: Cung
    c\u1EA5p n\u0103ng l\u01B0\u1EE3ng (\u0111\u1ED1t nhi\xEAn li\u1EC7u, pin, \u1EAFc
    quy) v\xE0 l\xE0 n\u1EC1n t\u1EA3ng luy\u1EC7n kim, s\u1EA3n xu\u1EA5t h\xF3a
    ch\u1EA5t, d\u01B0\u1EE3c ph\u1EA9m.\r\n- C\u01A1 th\u1EC3 ng\u01B0\u1EDDi: Ti\xEAu
    ho\xE1 th\u1EE9c \u0103n, chuy\u1EC3n ho\xE1 d\u01B0\u1EE1ng ch\u1EA5t v\xE0
    qu\xE1 tr\xECnh l\xE3o ho\xE1.\r\n- T\xE1c h\u1EA1i: G\xE2y \u0103n m\xF2n, g\u1EC9
    s\xE9t kim lo\u1EA1i."
