      m_Calls: []
  m_text: "MUC TI\xCAU B\xC0I HOC:\n\n- S\u1ED1 oxi ho\xE1: Hi\u1EC3u kh\xE1i ni\u1EC7m
    v\xE0 x\xE1c \u0111\u1ECBnh \u0111\u01B0\u1EE3c s\u1ED1 oxi ho\xE1.\r\n- Ph\u1EA3n
    \u1EE9ng oxi ho\xE1 \u2013 kh\u1EED: N\xEAu \u0111\u01B0\u1EE3c kh\xE1i ni\u1EC7m
    v\xE0 \xFD ngh\u0129a.\r\n- C\xE2n b\u0103ng ph\u01B0\u01A1ng tr\xECnh: L\u1EADp
    ph\u01B0\u01A1ng tr\xECnh b\u0103ng ph\u01B0\u01A1ng ph\xE1p th\u0103ng b\u0103ng
    electron.\r\n- Th\u1EF1c ti\xEAn: Nh\u1EADn bi\u1EBFt \u0111\u01B0\u1EE3c c\xE1c
    ph\u1EA3n \u1EE9ng quan tr\u1ECDng trong \u0111\u1EDDi s\u1ED1ng."
